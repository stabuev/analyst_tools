{
  "version": "2.0.0",
  "parser": "html.parser",
  "encoding": "utf-8",
  "container_selector": "[data-orders]",
  "record_selector": "[data-order-card]",
  "record_count": {
    "mode": "exact",
    "value": 2
  },
  "record_id": {
    "name": "order_id",
    "attribute": "data-order-id"
  },
  "fields": {
    "user_id": {
      "selector": "[data-field='user']",
      "source": "text",
      "type": "string",
      "non_blank": true
    },
    "amount": {
      "selector": "[data-field='amount']",
      "source": "text",
      "type": "decimal",
      "non_blank": true
    }
  }
}
