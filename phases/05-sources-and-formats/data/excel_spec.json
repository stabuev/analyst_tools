{
  "version": "2.0.0",
  "description": "Спецификация извлечения таблицы заказов из рабочей Excel-книги.",
  "sheet": "Заказы",
  "boundary": {
    "mode": "fixed_range",
    "range": "A4:F9",
    "reject_nonempty_below": true
  },
  "columns": {
    "order_id": {"type": "string", "nullable": false},
    "user_id": {"type": "string", "nullable": false},
    "ordered_at": {
      "type": "local_datetime",
      "nullable": false,
      "source_timezone": "Europe/Moscow"
    },
    "amount": {"type": "number", "nullable": false},
    "currency": {"type": "string", "nullable": false},
    "item_count": {"type": "integer", "nullable": false}
  },
  "key": ["order_id"],
  "formula_policy": "forbid_in_range",
  "layout_policy": "forbid_in_range"
}
