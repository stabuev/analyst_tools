{
  "version": "2.0.0",
  "description": "Контракт нормализации вложенных событий и позиций.",
  "root_path": "events",
  "envelope_fields": {
    "exported_at": {
      "path": "exported_at",
      "type": "timestamp",
      "required": true,
      "nullable": false,
      "require_timezone": true
    }
  },
  "record_grain": ["event_id"],
  "record_fields": {
    "event_id": {
      "path": "event_id",
      "type": "string",
      "required": true,
      "nullable": false
    },
    "user_id": {
      "path": "user.id",
      "type": "string",
      "required": true,
      "nullable": false
    },
    "occurred_at": {
      "path": "occurred_at",
      "type": "timestamp",
      "required": true,
      "nullable": false,
      "require_timezone": true
    },
    "device_os": {
      "path": "context.device.os",
      "type": "string",
      "required": true,
      "nullable": true
    },
    "screen": {
      "path": "context.screen",
      "type": "string",
      "required": true,
      "nullable": false
    }
  },
  "array": {
    "path": "items",
    "required": true,
    "nullable": false,
    "position_field": "item_position",
    "grain": ["event_id", "item_position"],
    "fields": {
      "product_id": {
        "path": "product_id",
        "type": "string",
        "required": true,
        "nullable": false
      },
      "quantity": {
        "path": "quantity",
        "type": "integer",
        "required": true,
        "nullable": false
      },
      "price": {
        "path": "price",
        "type": "number",
        "required": true,
        "nullable": false
      }
    }
  },
  "unknown_path_policy": "error",
  "allowed_paths": [
    "events",
    "events[]",
    "events[].context",
    "events[].context.device",
    "events[].context.device.os",
    "events[].context.screen",
    "events[].event_id",
    "events[].items",
    "events[].items[]",
    "events[].items[].price",
    "events[].items[].product_id",
    "events[].items[].quantity",
    "events[].occurred_at",
    "events[].user",
    "events[].user.id",
    "exported_at"
  ]
}
