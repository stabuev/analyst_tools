{
  "version": "1.0.0",
  "pipeline_version": "orders-delivery-v1",
  "source": {
    "start_url": "https://api.example.test/orders?page=1",
    "allowed_origin": "https://api.example.test",
    "items_field": "items",
    "next_field": "next",
    "page_number_field": "page",
    "max_pages": 100
  },
  "http": {
    "connect_timeout_seconds": 3.05,
    "read_timeout_seconds": 30.0,
    "max_page_bytes": 10000000,
    "max_redirects": 3,
    "retries_per_page": 3,
    "backoff_factor_seconds": 0.5,
    "max_retry_after_seconds": 30.0
  },
  "integrity": {
    "algorithm": "sha256"
  }
}
