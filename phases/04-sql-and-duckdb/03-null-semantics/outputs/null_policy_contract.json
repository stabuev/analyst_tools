{
  "input": {
    "relation": "orders",
    "grain": [
      "order_id"
    ],
    "required_columns": [
      {
        "name": "order_id",
        "type": "VARCHAR",
        "nullable": false
      },
      {
        "name": "amount",
        "type": "DECIMAL(18,2)",
        "nullable": true
      }
    ]
  },
  "policy": {
    "threshold": "100.00",
    "comparison": ">",
    "where_keeps": "TRUE",
    "states": {
      "above": "above_threshold",
      "not_above": "at_or_below_threshold",
      "missing": "missing"
    },
    "missing_rule": "A missing amount remains UNKNOWN in the comparison and is classified explicitly before threshold branches."
  },
  "output": {
    "grain": [
      "order_id"
    ],
    "columns": [
      {
        "name": "order_id",
        "type": "VARCHAR"
      },
      {
        "name": "amount",
        "type": "DECIMAL(18,2)"
      },
      {
        "name": "amount_above_threshold",
        "type": "BOOLEAN"
      },
      {
        "name": "amount_not_above_threshold",
        "type": "BOOLEAN"
      },
      {
        "name": "amount_is_missing",
        "type": "BOOLEAN"
      },
      {
        "name": "amount_state",
        "type": "VARCHAR"
      }
    ],
    "order_by": [
      {
        "column": "order_id",
        "direction": "asc"
      }
    ]
  },
  "expected_on_tiny": {
    "above_threshold": [
      "O1001",
      "O1002",
      "O1005",
      "O1007",
      "O1009",
      "O1012"
    ],
    "at_or_below_threshold": [
      "O1003",
      "O1006",
      "O1010",
      "O1011"
    ],
    "missing": [
      "O1004",
      "O1008"
    ]
  }
}
