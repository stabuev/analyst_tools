{
  "version": "2.0.0",
  "description": "Детерминированные пользовательские journeys для EDA, визуальных сравнений и анализа неопределенности.",
  "generator": "generate_data.py",
  "profiles": {
    "tiny": {
      "description": "Десятки строк для ручной проверки и behavioral tests.",
      "tracked": true,
      "default_rows": 25
    },
    "sample": {
      "description": "Около 20 тысяч строк для распределений, overplotting, faceting и bootstrap.",
      "tracked": false,
      "default_rows": 20001,
      "seed": 20260613
    }
  },
  "table": {
    "name": "user_journeys",
    "file": "user_journeys.csv",
    "grain": "Одна строка на пользователя и одно семидневное окно после регистрации.",
    "primary_key": [
      "user_id"
    ],
    "unexpected_columns": "warning",
    "time_range": {
      "column": "registered_at",
      "min": "2026-01-05T09:00:00+03:00",
      "max": "2026-04-05T18:00:00+03:00"
    },
    "columns": {
      "user_id": {
        "type": "string",
        "semantic_type": "user identifier",
        "nullable": false,
        "blank_allowed": false
      },
      "registered_at": {
        "type": "timestamp",
        "semantic_type": "registration timestamp",
        "nullable": false,
        "timezone_required": true
      },
      "cohort_week": {
        "type": "date",
        "semantic_type": "business calendar week start",
        "nullable": false
      },
      "platform": {
        "type": "category",
        "semantic_type": "client platform",
        "nullable": false,
        "allowed": [
          "web",
          "ios",
          "android"
        ]
      },
      "app_version": {
        "type": "string",
        "semantic_type": "application version",
        "nullable": true
      },
      "country": {
        "type": "string",
        "semantic_type": "country code",
        "nullable": true
      },
      "acquisition_channel": {
        "type": "category",
        "semantic_type": "acquisition category",
        "nullable": false,
        "allowed": [
          "organic",
          "search",
          "paid_social",
          "partner"
        ]
      },
      "plan": {
        "type": "category",
        "semantic_type": "subscription plan",
        "nullable": false,
        "allowed": [
          "trial",
          "basic",
          "premium"
        ]
      },
      "observed_days": {
        "type": "integer",
        "semantic_type": "observed days after registration",
        "nullable": false,
        "min": 1,
        "max": 7
      },
      "onboarding_seconds": {
        "type": "integer",
        "semantic_type": "onboarding duration in seconds",
        "nullable": false,
        "min": 0
      },
      "sessions_7d": {
        "type": "integer",
        "semantic_type": "sessions during the complete observation window",
        "nullable": true,
        "min": 0
      },
      "activated_7d": {
        "type": "boolean",
        "semantic_type": "activation outcome during the complete window",
        "nullable": true
      },
      "first_order_amount_rub": {
        "type": "decimal",
        "semantic_type": "first order amount in RUB",
        "nullable": true,
        "min": 0
      },
      "support_tickets_7d": {
        "type": "integer",
        "semantic_type": "support tickets during the complete observation window",
        "nullable": true,
        "min": 0
      }
    },
    "rules": {
      "cohort_alignment": {
        "registered_column": "registered_at",
        "cohort_column": "cohort_week",
        "week_starts_on": 0
      },
      "app_version": {
        "column": "app_version",
        "not_applicable_when": {
          "column": "platform",
          "equals": "web"
        },
        "required_otherwise": true
      },
      "observation_window": {
        "column": "observed_days",
        "complete_value": 7,
        "required_when_complete": [
          "sessions_7d",
          "activated_7d",
          "support_tickets_7d"
        ],
        "must_be_missing_when_incomplete": [
          "sessions_7d",
          "activated_7d",
          "first_order_amount_rub",
          "support_tickets_7d"
        ]
      },
      "first_order_amount": {
        "column": "first_order_amount_rub",
        "required_when": {
          "column": "activated_7d",
          "equals": "true"
        }
      }
    },
    "analysis_profiles": {
      "activation_7d": {
        "description": "Семидневная activation по недельным когортам и объявленным сегментам.",
        "required_columns": [
          "user_id",
          "registered_at",
          "cohort_week",
          "platform",
          "acquisition_channel",
          "observed_days",
          "activated_7d"
        ],
        "eligibility": {
          "column": "observed_days",
          "operator": "eq",
          "value": 7
        }
      },
      "onboarding_distribution": {
        "description": "Распределение длительности onboarding среди наблюдаемых пользователей.",
        "required_columns": [
          "user_id",
          "platform",
          "onboarding_seconds"
        ],
        "eligibility": null
      }
    },
    "generation_rules": [
      "Строки создаются детерминированно и покрывают периоды до и после контрольной даты.",
      "Fixture содержит группы разного размера, допустимые хвосты и намеренные нарушения контракта для аудита.",
      "Точный аналитический паттерн не является частью student-facing контракта и должен быть обнаружен расчётом."
    ],
    "known_defects": [
      "Tiny fixture может содержать намеренные нарушения; их тип, строки и влияние нужно установить аудитором до анализа."
    ]
  }
}
